# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SUGGESTIONS_CHANNEL_ID=
# Opcional: se preenchido, só membros com este cargo podem enviar implementações.
SUBMITTER_ROLE_ID=

# ---------------------------------------------------------------------------
# Repositório e fila
# ---------------------------------------------------------------------------
# Deixe vazio para usar a pasta pai de bot/.
REPO_PATH=
MAIN_BRANCH=master

# Deixe vazio para usar ../.2d-survivor-worktrees ao lado do repo.
WORKTREE_DIR=

# Opcionais: caminhos e log.
# DATABASE_PATH=
# LOG_DIR=
# LOG_LEVEL=info

# A fila fica ativa. O worker clona origin/master; WIP local não bloqueia.
MAX_ACTIVE_PER_USER=1
DAILY_USER_LIMIT=15
DAILY_GLOBAL_LIMIT=20
QUEUE_LIMIT=20
MIN_ACCOUNT_AGE_DAYS=7

# Limites de blast radius: acima disso o job falha e a branch fica no origin.
MAX_DIFF_FILES=20
MAX_DIFF_LINES=800

# Timeouts em minutos.
JOB_TIMEOUT_MIN=20
BUILD_TIMEOUT_MIN=10
LINT_TIMEOUT_MIN=5

# Se o repo já tiver erros de lint antigos, coloque false para não bloquear tudo.
LINT_STRICT=true

WORKER_POLL_MS=2000

# ---------------------------------------------------------------------------
# Identidade dos commits do worker
# ---------------------------------------------------------------------------
# Use um e-mail verificado na conta GitHub (o Vercel valida o autor do commit).
GIT_AUTHOR_NAME=2d-survivor bot
GIT_AUTHOR_EMAIL=6431486+victoprincipe@users.noreply.github.com

# ---------------------------------------------------------------------------
# OpenCode (worker)
# ---------------------------------------------------------------------------
OPENCODE_BIN=opencode
AGENT_NAME=implementer
# Opcional, formato provider/model#variant. Ex.: anthropic/claude-sonnet-4-5
# Sem isso, o OpenCode usa o default dele (que pode ser um modelo free/ fraco).
# Rode `opencode models` para listar os IDs disponíveis.
AGENT_MODEL=
# Modelo com visão usado automaticamente quando o job tem imagens.
# Precisa aceitar imagem; modelos text-only rejeitam o anexo.
AGENT_VISION_MODEL=opencode/nemotron-3.5-super-vl-free
# Modelo do planejador. Vazio = usa AGENT_MODEL.
AGENT_PLANNER_MODEL=

# ---------------------------------------------------------------------------
# Imagens e áudios nos prompts
# ---------------------------------------------------------------------------
# Limite por prompt e por anexo (MB). Imagens: PNG, JPEG, GIF, WebP.
MAX_PROMPT_IMAGES=3
MAX_IMAGE_MB=8
# Áudios: MP3, WAV, OGG/OPUS, M4A/AAC, FLAC, WebM.
MAX_PROMPT_AUDIOS=3
MAX_AUDIO_MB=10
# Pastas em bot/data/assets/ mais antigas que isso são removidas no start do worker.
IMAGE_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Planejamento (/planejar)
# ---------------------------------------------------------------------------
# Planejamentos usam o mesmo reset de quota (npm run quota:reset), mas têm
# limites próprios e não consomem os 15/dia de implementação.
DAILY_PLAN_LIMIT=10
MAX_ACTIVE_PLANS_PER_USER=1
PLAN_QUEUE_LIMIT=10
PLAN_TIMEOUT_MIN=10
